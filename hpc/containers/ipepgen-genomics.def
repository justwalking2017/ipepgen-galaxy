Bootstrap: docker
From: mambaorg/micromamba:2.3.2

%post
    micromamba install -y -n base -c conda-forge -c bioconda \
      star=2.7.10b arriba=2.4.0 hisat2=2.2.1 samtools=1.22 \
      stringtie=2.2.3 gffcompare=0.12.6 freebayes=1.3.6 \
      bcftools=1.22 htslib=1.22 gffread=0.12.7 python=3.12
    micromamba clean -a -y

%environment
    export PATH=/opt/conda/bin:$PATH

