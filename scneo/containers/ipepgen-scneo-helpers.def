Bootstrap: docker
From: python:3.12-slim

%labels
    org.opencontainers.image.title iPepGen scNeo helper tools
    org.opencontainers.image.licenses MIT

%post
    python -m pip install --no-cache-dir biopython==1.85

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec python "$@"
